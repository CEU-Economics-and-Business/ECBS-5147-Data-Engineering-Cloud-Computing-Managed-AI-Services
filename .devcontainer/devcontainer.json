// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "CEU Cloud Class Image",
	"image": "ghcr.io/zoltanctoth/ceu-cloud-class:latest",
	"initializeCommand": "docker pull ghcr.io/zoltanctoth/ceu-cloud-class:latest",
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-toolsai.jupyter@2025.7.0",
				"ms-python.python",
				"ms-python.black-formatter",
				"humao.rest-client",
				"ms-python.isort",
				"ms-python.flake8",
				"GitHub.copilot"
			]
		}
	},
	"remoteEnv": {
		"WORKSPACE_FOLDER": "${localWorkspaceFolder}"
	},
	"containerEnv": {
		"AWS_DEFAULT_REGION": "eu-west-1"
	},
	"postCreateCommand": "bash .devcontainer/setup-container.sh",
}